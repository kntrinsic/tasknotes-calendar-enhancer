{
  "name": "tasknotes-calendar-enhancer",
  "version": "0.3.0",
  "private": true,
  "description": "Companion plugin for TaskNotes adding a Bases toolbar calendar picker, startup cache, mobile month chips & popover UX, quick create, custom colors, and weekend/holiday colors.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:test-vault": "node scripts/deploy-test-vault.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "obsidian": "^1.14.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
