{
  "name": "tasknotes-calendar-enhancer",
  "version": "0.0.1",
  "private": true,
  "description": "Companion plugin for TaskNotes with a Bases toolbar calendar picker, local startup cache for external calendars, and mobile month tap improvements.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
